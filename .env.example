# Start command: ./start (Mac/Linux) or .\start.cmd (Windows).
# It generates BRIDGE_TOKEN when blank.
BRIDGE_TOKEN=
RUN_MODE=container
# Generated once by the start command; keep it stable for disaster cleanup.
DEPLOYMENT_ID=
# Use an ngrok token for automatic tunneling, OR set your own public HTTPS URL.
NGROK_AUTHTOKEN=
PUBLIC_URL=
MEETSTREAM_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
BOT_NAME=MeetStream Pipecat
LLM_MODEL=gemini-3.5-flash-lite
TTS_VOICE=aura-2-helena-en
MAX_SESSIONS=4
MAX_MEETING_SECONDS=3600
JOIN_TIMEOUT_SECONDS=300
RECORD_AUDIO=false
